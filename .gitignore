# ─────────────────────────────────────────────────────────
# Everything Antigravity (EAG) — .gitignore
# ─────────────────────────────────────────────────────────

# ── Node / JS ──────────────────────────────────────────
node_modules/
dist/
build/
.next/
out/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.Python

# ── OS Artifacts ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ── Environment & Secrets ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.secret

# ── Temp / Test Scaffolds ──────────────────────────────
temp/
tmp/
*.tmp
test-scaffold-app/
scratch/

# ── Editor / IDE ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Release Artifacts ──────────────────────────────────
*.tgz
*.tar.gz
